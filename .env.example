# Copy to `.env` (repo root, for docker compose) and/or `backend/.env` (for uvicorn run from
# backend/). Both copies are git-ignored. Placeholders only: never commit real values.
# Commit this file with: git add -f .env.example   (the root .gitignore matches .env.*)

# Secret salt for the pseudonymous on-chain borrower ID: borrowerRef = SHA-256(borrowerId + salt).
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Required to mint loan notes (approval returns "mint_failed" without it).
AL_BORROWER_REF_SALT=change-me-to-a-long-random-string

# "web3" = LoanNote on the local anvil chain; "fake" = in-memory chain for demos without anvil.
AL_CHAIN_MODE=web3
AL_CHAIN_RPC_URL=http://127.0.0.1:8545
AL_CHAIN_DEPLOYMENT_FILE=../contracts/deployments/local.json

# Optional. Private key that signs mint/audit transactions (needs MINTER_ROLE).
# Leave empty to use anvil's first unlocked dev account (local chain only).
AL_CHAIN_SIGNER_KEY=
# Optional. Bank address that receives the loan notes. Empty = the signer's address.
AL_CHAIN_BANK_ADDRESS=

# APR written on the loan note, in basis points (390 = 3.90 %).
AL_DEFAULT_APR_BPS=390
